# ══════════════════════════════════════════════════════════════════════════════
# 🔐 RECOMMENDED — Telegram
# ══════════════════════════════════════════════════════════════════════════════
# Get TG_BOT_TOKEN from @BotFather.
TG_BOT_TOKEN=YOUR_BOT_TOKEN

# Optional. Current bot uses Telegram Bot API, so APP_ID/API_HASH can stay blank.
APP_ID=0
API_HASH=


# ══════════════════════════════════════════════════════════════════════════════
# 👑 MAIN — Owner / Admin
# ══════════════════════════════════════════════════════════════════════════════
# Your Telegram numeric user ID.
OWNER_ID=YOUR_TELEGRAM_USER_ID

# Optional extra admins. Comma-separated numeric IDs.
# ADMIN_IDS=123456789,987654321

# Render/VPS worker port (normally not used by the Telegram bot).
PORT=8028


# ══════════════════════════════════════════════════════════════════════════════
# 🍃 DATABASE — MongoDB
# ══════════════════════════════════════════════════════════════════════════════
# Use your MongoDB Atlas connection string here.
# Example format only — NEVER commit your real password to GitHub.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/
DATABASE_NAME=instagram_channel_bot


# ══════════════════════════════════════════════════════════════════════════════
# 📡 MONITORING — lightweight 24/7
# ══════════════════════════════════════════════════════════════════════════════
# 1800 seconds = 30 minutes (startup/default value).
# You can change it live with /set_time 45m or /set_time 1h.
POST_TIME_SECONDS=1800
# MONITOR_INTERVAL_SECONDS=1800  # old name, kept for compatibility

# Number of recent items checked during normal monitoring.
FETCH_LIMIT=5

# Small delay between different Instagram profiles.
MONITOR_PROFILE_DELAY=2


# ══════════════════════════════════════════════════════════════════════════════
# 📦 /allpost — safe background processing
# ══════════════════════════════════════════════════════════════════════════════
ALLPOST_ITEM_DELAY=2
ALLPOST_BATCH_SIZE=20
ALLPOST_BATCH_PAUSE=10


# ══════════════════════════════════════════════════════════════════════════════
# 📤 TELEGRAM — uploads + error handling
# ══════════════════════════════════════════════════════════════════════════════
TELEGRAM_UPLOAD_DELAY=0.7
MAX_RETRIES=3
ERROR_ALERT_COOLDOWN=21600


# ══════════════════════════════════════════════════════════════════════════════
# 📁 FILES / INSTAGRAM LOGIN
# ══════════════════════════════════════════════════════════════════════════════
# Temporary files are deleted after upload.
DOWNLOADS_DIR=data/downloads

# Optional authenticated Instaloader session.
# Leave blank for public-profile monitoring.
IG_LOGIN_USERNAME=
IG_SESSION_FILE=

# =============================================================================
# 🚀 WEBHOOK - Render Service Settings
# =============================================================================
# For Render Web Service, add the base URL of your service (e.g. https://YOUR-SERVICE.onrender.com)
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
